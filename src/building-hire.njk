      </div>
      <p class="note full">Please note: Filling in this form doesn't automatically guarantee your booking.&nbsp; Someone will be back in touch with you with a final quote before final confirmation</p>
      <label class="check full"><input type="checkbox" name="terms" required> I agree to the terms &amp; conditions&nbsp;<a href="/hireterms" target="_blank">View terms of booking (opens in new window)</a></label>
    </div>
    <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    <p class="form-status" role="status" style="text-align:center;margin-top:16px"></p>
    <button type="submit">Submit</button>
  </form>
</section>
