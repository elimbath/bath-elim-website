{
  // Cloudflare Worker settings. The site is built by `npm run build` into _site,
  // then `npx wrangler deploy` uploads it with worker.js (which handles /api/*).
  "name": "bath-elim-website",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Keep the variables/secrets set in the Cloudflare dashboard when deploying.
  "keep_vars": true
}
